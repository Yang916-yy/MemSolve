{
  "model": {
    "model_type": "memsolve_bert",
    "vocab_size": 30522,
    "hidden_size": 768,
    "num_hidden_layers": 14,
    "num_attention_heads": 12,
    "intermediate_size": 2048,
    "max_position_embeddings": 512,
    "position_embedding_type": "rove",
    "memsolve_rotary_base": 10000.0,
    "memsolve_rotary_train_length": 128,
    "memsolve_rotary_scaling": "yarn",
    "memsolve_rank": 32,
    "memsolve_implementation": "cuda",
    "ffn_type": "swiglu",
    "memsolve_core_mode": "equilibrium",
    "memsolve_short_conv_kernel": 3
  },
  "global_batch_size": 4096,
  "train_mask_probability": 0.3,
  "training": {
    "max_steps": 70000,
    "per_device_train_batch_size": 512,
    "per_device_eval_batch_size": 128,
    "learning_rate": 0.0008,
    "weight_decay": 0.0125,
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "adam_epsilon": 1e-06,
    "max_grad_norm": 1.0,
    "optim": "adamw_torch_fused",
    "lr_scheduler_type": "polynomial",
    "lr_scheduler_kwargs": {
      "lr_end": 1.6e-05,
      "power": 1.0
    },
    "warmup_ratio": 0.06,
    "bf16": true,
    "bf16_full_eval": false,
    "average_tokens_across_devices": true,
    "remove_unused_columns": false,
    "eval_strategy": "steps",
    "eval_steps": 1000,
    "save_strategy": "steps",
    "save_steps": 1000,
    "save_total_limit": 3,
    "load_best_model_at_end": true,
    "metric_for_best_model": "masked_nll",
    "greater_is_better": false,
    "logging_steps": 10,
    "report_to": "none",
    "seed": 17,
    "data_seed": 17,
    "dataloader_num_workers": 8,
    "dataloader_persistent_workers": true,
    "dataloader_drop_last": false,
    "ddp_find_unused_parameters": false,
    "save_safetensors": true,
    "dataloader_prefetch_factor": 2,
    "disable_tqdm": true,
    "accelerator_config": {
      "dispatch_batches": false,
      "split_batches": false
    }
  },
  "streaming_shuffle_buffer": 10000,
  "execution": "compile-graph"
}
